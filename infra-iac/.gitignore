# Deployment-layer artifacts. Kept out of the root .gitignore because that file
# is part of the byte-for-byte upstream import and would lose these entries on
# the next code sync.

# Holds the real access token and team API key after init-db.sh seeds the
# database. Regenerated by init-config.sh + init-db.sh on every run.
db/config.json

# terraform/start.sh writes this plan file; it contains resolved sensitive
# values (generated ACL tokens, the volume token signing key).
terraform/tfplan

# Rendered by terraform/prepare.sh from /opt/config.properties.
terraform/var.tf
terraform/provider.tf
